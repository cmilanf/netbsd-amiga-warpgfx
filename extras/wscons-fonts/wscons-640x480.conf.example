# Optional WarpGFX 640x480 wscons font policy (kernel built with mode=480).
#
# Merge selected lines into /etc/wscons.conf manually; do not replace the whole
# system file. Keep ttyE0 unchanged as the boot/recovery console. This example
# creates ttyE1-ttyE3 as exact-fit ISO consoles and ttyE4 as a raw CP437
# ANSI/BBS console. It does not create ttyE5 or modify /etc/ttys.
# If install.sh used a non-default --prefix, replace /usr/local below with it.
#
# The ISO consoles use the unmodified Terminus 8x16 font that NetBSD already
# installs; this bundle adds only the raw-CP437 VGA font for this mode.
#
# Columns: name width height encoding file
font	Terminus16-ISO8859-1	-	-	-	/usr/share/wscons/fonts/ter-116n.wsf

# Columns: index screen-type emulation
# 80 * 8 = 640; 30 * 16 = 480.
screen	1	80x30	vt100
screen	2	80x30	vt100
screen	3	80x30	vt100
# 80 * 8 = 640; 25 * 16 = 400, centred with 40-line borders: the original
# VGA text-mode geometry.
screen	4	80x25	vt100

# Load the raw-CP437 font after creating the screens, then assign fonts
# explicitly. Its WSF encoding is intentionally ISO/direct so wsemul_vt100
# sends high-bit BBS bytes to the same-numbered CP437 glyph slots.
font	WarpConsole-VGA-CP437-Raw-8x16	-	-	-	/usr/local/share/wscons/fonts/WarpConsole-VGA-CP437-Raw-8x16.wsf
setvar	ttyE1	font	Terminus16-ISO8859-1
setvar	ttyE2	font	Terminus16-ISO8859-1
setvar	ttyE3	font	Terminus16-ISO8859-1
setvar	ttyE4	font	WarpConsole-VGA-CP437-Raw-8x16

# Deliberately no ttyE0 font assignment and no screen/setvar entry for ttyE5.
